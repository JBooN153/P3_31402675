# ==========================================
# CONFIGURACIÓN DEL FRONTEND
# ==========================================

# URL de la API backend
# En desarrollo: http://localhost:3000
# En producción: https://tu-api.onrender.com
VITE_API_URL=http://localhost:3000

# Ambiente
VITE_NODE_ENV=development

# ==========================================
# NOTAS IMPORTANTES
# ==========================================
# 1. Las variables deben empezar con VITE_ para ser accesibles en el cliente
# 2. En producción, Render puede establecer estas automáticamente
# 3. El VITE_API_URL debe apuntar al servidor API correcto