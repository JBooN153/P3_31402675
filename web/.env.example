# ==========================================
# CONFIGURACIÓN DEL FRONTEND
# ==========================================

# Puerto de la API backend
# En desarrollo: 10000 (Render), 3000 (local)
# En producción: Usar window.location.origin automáticamente
VITE_API_PORT=10000

# URL completa de la API (opcional, sobrescribe VITE_API_PORT)
# VITE_API_URL=http://localhost:10000

# Ambiente
VITE_NODE_ENV=development

# ==========================================
# NOTAS IMPORTANTES
# ==========================================
# 1. Las variables deben empezar con VITE_ para ser accesibles en el cliente
# 2. En producción, Render puede establecer estas automáticamente
# 3. El VITE_API_URL debe apuntar al servidor API correcto